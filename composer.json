{
    "name": "wu/giorgio-socket",
    "description": "Laravel WebSocket server with Swoole and native PHP transports",
    "keywords": [
        "Laravel",
        "Swoole",
        "Socket",
        "Im"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "m-finder",
            "email": "yf-wu@qq.com"
        }
    ],
    "require": {
        "php": "^8.0.2",
        "laravel/framework": ">=9.0"
    },
    "suggest": {
        "ext-swoole": "Preferred WebSocket transport on non-Windows systems",
        "ext-openssl": "Required for direct TLS listeners"
    },
    "autoload": {
        "psr-4": {
            "GiorgioSocket\\": "src",
            "GiorGioSocket\\Services\\Handlers\\": "src/Services/Handlers"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GiorgioSocket\\Providers\\SocketServiceProvider",
                "GiorgioSocket\\Providers\\EventServiceProvider"
            ]
        }
    }
}
